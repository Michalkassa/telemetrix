# Copy to .env (git-ignored) to change the defaults. Every value also has a default in
# docker-compose.yml, so the stack starts without a .env.
POSTGRES_DB=telemetrix
POSTGRES_USER=telemetrix
POSTGRES_PASSWORD=telemetrix

# host ports
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# season calendars imported when the stack starts (space-separated; safe to repeat)
SEED_SEASONS=2024

# security (docs/adr/0007; README, Configuration) — none needed to browse
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# TELEMETRIX_ADMINS=your-github-login
# TELEMETRIX_ANALYSTS=
# the seed's ADMIN API key and its SHA-256 (printf '<key>' | shasum -a 256); defaults are a dev pair
# SEED_API_KEY=telemetrix-dev-seed-key
# SEED_API_KEY_SHA256=3269123ed71ec32853e5e11324d321a4116cdfca4a5591f3ae855dc2041d766d
