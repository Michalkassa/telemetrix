# Copy to .env (git-ignored) to change the defaults. Every value also has a default in
# docker-compose.yml, so the stack starts without a .env.
POSTGRES_DB=telemetrix
POSTGRES_USER=telemetrix
POSTGRES_PASSWORD=telemetrix

# host ports
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# season calendars imported when the stack starts (space-separated; safe to repeat)
SEED_SEASONS=2024
